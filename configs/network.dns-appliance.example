# Example UCI network snippet for DNS appliance (not applied automatically by build).
# Default values match leandns UCI lan section.

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.0.250'
	option netmask '255.255.255.0'
	option gateway '192.168.0.1'
	option ip6assign '0'
