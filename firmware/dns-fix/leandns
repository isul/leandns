#!/bin/sh
# rpcd plugin for LeanDNS (BusyBox ash). Speaks JSON on stdout.
# Methods mirror ACL in /usr/share/rpcd/acl.d/leandns.json

. /usr/share/libubox/jshn.sh 2>/dev/null || true

HOSTS=/etc/leandns/hosts
ALLOW=/etc/leandns/allow.list
BLOCK=/etc/leandns/block.list
VALIDATE=/usr/bin/leandns-validate

case "$1" in
	list)
		cat <<'EOF'
{
	"ping": {},
	"auth_required": {},
	"status": {},
	"dns_get": {},
	"dns_set": {
		"upstream": [],
		"cachesize": 1000,
		"internal_domain": "home.arpa",
		"ipv6_dns": false,
		"dns_test_host": "one.one.one.one"
	},
	"dns_test": {},
	"dns_restart": {},
	"hosts_list": {},
	"hosts_set": { "hosts": [] },
	"adblock_status": {},
	"adblock_set": { "enabled": true },
	"adblock_update": {},
	"lists_get": {},
	"lists_set": { "allow": [], "block": [] },
	"system_info": {},
	"system_restart_services": {},
	"logs_get": { "lines": 100 },
	"logs_clear": {},
	"backup_export": {},
	"backup_import": { "data_base64": "" },
	"password_changed": {},
	"network_get": {},
	"network_set": {
		"ipaddr": "192.168.0.250",
		"netmask": "255.255.255.0",
		"gateway": "192.168.0.1"
	},
	"udp_token_get": {},
	"udp_token_regen": {}
}
EOF
		;;
	call)
		method="$2"
		# Full stdin (do not use read -r; JSON may be multi-line)
		input="$(cat)"
		[ -n "$input" ] || input="{}"
		case "$method" in
			ping)
				echo '{"ok":true,"service":"leandns","version":"1.0.0"}'
				;;
			auth_required)
				force="$(uci -q get leandns.main.force_password_change 2>/dev/null || echo 1)"
				if [ "$force" = "1" ]; then
					echo '{"force_password_change":true}'
				else
					echo '{"force_password_change":false}'
				fi
				;;
			status)
				/usr/libexec/leandns/status.sh --quick
				;;
			dns_get)
				domain="$(uci -q get leandns.main.internal_domain)"
				cache="$(uci -q get leandns.main.cachesize)"
				ipv6="$(uci -q get leandns.main.ipv6_dns)"
				test_host="$(uci -q get leandns.main.dns_test_host)"
				ups="$(/usr/libexec/leandns/upstream-list.sh get-json)"
				printf '{"upstream":[%s],"cachesize":%s,"internal_domain":"%s","ipv6_dns":%s,"dns_test_host":"%s"}\n' \
					"$ups" "${cache:-1000}" "${domain:-home.arpa}" \
					"$([ "${ipv6:-0}" = "1" ] && echo true || echo false)" \
					"${test_host:-one.one.one.one}"
				;;
			dns_set)
				# Prefer jshn when available
				cache=""; domain=""; test_host=""; ipv6_raw=""; have_upstream=0
				if [ -f /usr/share/libubox/jshn.sh ]; then
					# shellcheck disable=SC1091
					. /usr/share/libubox/jshn.sh
					json_init
					json_load "$input" 2>/dev/null || true
					json_get_var cache cachesize
					json_get_var domain internal_domain
					json_get_var test_host dns_test_host
					json_get_var ipv6_raw ipv6_dns
					json_get_type utype upstream
					if [ "$utype" = "array" ]; then
						have_upstream=1
						uptmp="$(mktemp)"
						json_select upstream
						json_get_keys ukeys
						for uk in $ukeys; do
							json_get_var srv "$uk"
							[ -n "$srv" ] && printf '%s\n' "$srv" >> "$uptmp"
						done
						json_select ..
					fi
				fi
				# Fallback sed parse
				[ -n "$cache" ] || cache="$(printf '%s' "$input" | sed -n 's/.*"cachesize"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"
				[ -n "$domain" ] || domain="$(printf '%s' "$input" | sed -n 's/.*"internal_domain"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				[ -n "$test_host" ] || test_host="$(printf '%s' "$input" | sed -n 's/.*"dns_test_host"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				[ -n "$ipv6_raw" ] || ipv6_raw="$(printf '%s' "$input" | sed -n 's/.*"ipv6_dns"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' | head -n1)"
				if [ "$have_upstream" != "1" ] && printf '%s' "$input" | grep -q '"upstream"[[:space:]]*:'; then
					have_upstream=1
					arr="$(printf '%s' "$input" | sed -n 's/.*"upstream"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' | head -n1)"
					uptmp="$(mktemp)"
					printf '%s\n' "$arr" | sed 's/"[[:space:]]*,[[:space:]]*"/\n/g; s/"//g' > "$uptmp"
				fi

				[ -n "$cache" ] && {
					"$VALIDATE" cachesize "$cache" || { echo '{"ok":false,"error":"invalid cachesize"}'; exit 0; }
					uci -q set leandns.main.cachesize="$cache"
				}
				[ -n "$domain" ] && {
					"$VALIDATE" domain "$domain" || { echo '{"ok":false,"error":"invalid domain"}'; exit 0; }
					uci -q set leandns.main.internal_domain="$domain"
				}
				[ -n "$test_host" ] && {
					"$VALIDATE" domain "$test_host" || { echo '{"ok":false,"error":"invalid dns_test_host"}'; exit 0; }
					uci -q set leandns.main.dns_test_host="$test_host"
				}
				case "$ipv6_raw" in
					true|1) uci -q set leandns.main.ipv6_dns='1' ;;
					false|0) uci -q set leandns.main.ipv6_dns='0' ;;
				esac

				if [ "$have_upstream" = "1" ] && [ -n "${uptmp:-}" ]; then
					/usr/libexec/leandns/upstream-list.sh set-lines < "$uptmp" >/dev/null
					rm -f "$uptmp"
				else
					uci commit leandns
				fi

				if /usr/libexec/leandns/apply-dns.sh --apply >/dev/null 2>&1; then
					echo '{"ok":true}'
				else
					echo '{"ok":false,"error":"apply failed; rolled back"}'
				fi
				;;
			dns_test)
				/usr/libexec/leandns/status.sh --quick | sed 's/^{/{"ok":true,/'
				;;
			dns_restart)
				if /etc/init.d/dnsmasq restart >/dev/null 2>&1; then
					echo '{"ok":true}'
				else
					echo '{"ok":false,"error":"restart failed"}'
				fi
				;;
			hosts_list)
				printf '{"hosts":['
				first=1
				[ -f "$HOSTS" ] && while IFS= read -r line || [ -n "$line" ]; do
					case "$line" in ''|\#*) continue ;; esac
					# shellcheck disable=SC2086
					set -- $line
					h="$1"; ip="$2"
					[ -n "$h" ] && [ -n "$ip" ] || continue
					[ "$first" = 1 ] || printf ','
					first=0
					printf '{"hostname":"%s","ip":"%s"}' "$h" "$ip"
				done < "$HOSTS"
				printf ']}\n'
				;;
			hosts_set)
				tmp="$(mktemp)"
				# Expect {"hosts":[{"hostname":"...","ip":"..."},...]}
				printf '%s' "$input" | sed 's/},{/}\n{/g' | while IFS= read -r obj; do
					h="$(printf '%s' "$obj" | sed -n 's/.*"hostname"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
					ip="$(printf '%s' "$obj" | sed -n 's/.*"ip"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
					[ -z "$h" ] && continue
					[ -z "$ip" ] && continue
					"$VALIDATE" hostrecord "$h" "$ip" || continue
					printf '%s %s\n' "$h" "$ip"
				done > "$tmp"
				# Deduplicate by hostname (last wins)
				awk '{h[$1]=$0} END {for (k in h) print h[k]}' "$tmp" | sort > "$HOSTS"
				rm -f "$tmp"
				if /usr/libexec/leandns/apply-dns.sh --apply >/dev/null 2>&1; then
					echo '{"ok":true}'
				else
					echo '{"ok":false,"error":"apply failed; rolled back"}'
				fi
				;;
			adblock_status)
				/usr/libexec/leandns/adblock-ctl.sh status
				;;
			adblock_set)
				en="$(printf '%s' "$input" | sed -n 's/.*"enabled"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' | head -n1)"
				if [ "$en" = "true" ]; then
					/usr/libexec/leandns/adblock-ctl.sh enable
				else
					/usr/libexec/leandns/adblock-ctl.sh disable
				fi
				;;
			adblock_update)
				/usr/libexec/leandns/adblock-ctl.sh update
				;;
			lists_get)
				printf '{"allow":['
				fa=1
				[ -f "$ALLOW" ] && while IFS= read -r d || [ -n "$d" ]; do
					case "$d" in ''|\#*) continue ;; esac
					[ "$fa" = 1 ] || printf ','
					fa=0
					printf '"%s"' "$d"
				done < "$ALLOW"
				printf '],"block":['
				fb=1
				[ -f "$BLOCK" ] && while IFS= read -r d || [ -n "$d" ]; do
					case "$d" in ''|\#*) continue ;; esac
					[ "$fb" = 1 ] || printf ','
					fb=0
					printf '"%s"' "$d"
				done < "$BLOCK"
				printf ']}\n'
				;;
			lists_set)
				tmpa="$(mktemp)"; tmpb="$(mktemp)"
				# Split allow / block sections crudely
				allow_part="$(printf '%s' "$input" | sed -n 's/.*"allow"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')"
				block_part="$(printf '%s' "$input" | sed -n 's/.*"block"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')"
				printf '%s\n' "$allow_part" | sed 's/"[[:space:]]*,[[:space:]]*"/\n/g; s/"//g' | while IFS= read -r d; do
					d="$(echo "$d" | tr -d '[:space:]')"
					[ -z "$d" ] && continue
					"$VALIDATE" domain "$d" || continue
					printf '%s\n' "$d"
				done | sort -u > "$tmpa"
				printf '%s\n' "$block_part" | sed 's/"[[:space:]]*,[[:space:]]*"/\n/g; s/"//g' | while IFS= read -r d; do
					d="$(echo "$d" | tr -d '[:space:]')"
					[ -z "$d" ] && continue
					"$VALIDATE" domain "$d" || continue
					printf '%s\n' "$d"
				done | sort -u > "$tmpb"
				cp "$tmpa" "$ALLOW"
				cp "$tmpb" "$BLOCK"
				rm -f "$tmpa" "$tmpb"
				/usr/libexec/leandns/adblock-ctl.sh sync-lists >/dev/null 2>&1 || true
				echo '{"ok":true}'
				;;
			system_info)
				/usr/libexec/leandns/status.sh --quick
				;;
			system_restart_services)
				/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
				/etc/init.d/leandns reload >/dev/null 2>&1 || true
				echo '{"ok":true}'
				;;
			logs_get)
				lines="$(printf '%s' "$input" | sed -n 's/.*"lines"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"
				lines="${lines:-100}"
				[ "$lines" -gt 500 ] && lines=500
				logread 2>/dev/null | grep -E 'dnsmasq|leandns|adblock' | tail -n "$lines" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'BEGIN{print "{\"lines\":["} {if(n++)printf ","; printf "\"%s\"",$0} END{print "]}"}'
				;;
			logs_clear)
				# Clearing persistent logs on flash is discouraged; truncate logd buffer if possible
				logread -c >/dev/null 2>&1 || true
				echo '{"ok":true,"note":"log buffer clear attempted"}'
				;;
			backup_export)
				/usr/libexec/leandns/backup.sh export
				;;
			backup_import)
				b64="$(printf '%s' "$input" | sed -n 's/.*"data_base64"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
				if [ -z "$b64" ]; then
					echo '{"ok":false,"error":"missing data_base64"}'
				else
					printf '%s' "$b64" | /usr/libexec/leandns/backup.sh import
				fi
				;;
			password_changed)
				uci -q set leandns.main.force_password_change='0'
				uci commit leandns
				echo '{"ok":true}'
				;;
			network_get)
				ipaddr="$(uci -q get network.lan.ipaddr)"
				netmask="$(uci -q get network.lan.netmask)"
				gateway="$(uci -q get network.lan.gateway)"
				printf '{"ipaddr":"%s","netmask":"%s","gateway":"%s"}\n' \
					"${ipaddr:-192.168.0.250}" "${netmask:-255.255.255.0}" "${gateway:-192.168.0.1}"
				;;
			network_set)
				ipaddr="$(printf '%s' "$input" | sed -n 's/.*"ipaddr"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				netmask="$(printf '%s' "$input" | sed -n 's/.*"netmask"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				gateway="$(printf '%s' "$input" | sed -n 's/.*"gateway"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				[ -n "$ipaddr" ] && [ -n "$netmask" ] && [ -n "$gateway" ] || {
					echo '{"ok":false,"error":"missing fields"}'
					exit 0
				}
				/usr/libexec/leandns/apply-network.sh "$ipaddr" "$netmask" "$gateway"
				;;
			udp_token_get)
				mkdir -p /etc/leandns
				if [ ! -s /etc/leandns/udp.token ]; then
					tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 24 > /etc/leandns/udp.token || \
						date +%s | md5sum | cut -c1-24 > /etc/leandns/udp.token
					chmod 600 /etc/leandns/udp.token
				fi
				tok="$(cat /etc/leandns/udp.token 2>/dev/null | tr -d '\n\r')"
				printf '{"token":"%s","port":37421}\n' "$tok"
				;;
			udp_token_regen)
				mkdir -p /etc/leandns
				tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 24 > /etc/leandns/udp.token || \
					date +%s | md5sum | cut -c1-24 > /etc/leandns/udp.token
				chmod 600 /etc/leandns/udp.token
				tok="$(cat /etc/leandns/udp.token | tr -d '\n\r')"
				printf '{"ok":true,"token":"%s","port":37421}\n' "$tok"
				;;
			*)
				echo '{"error":"unknown method"}'
				;;
		esac
		;;
esac
