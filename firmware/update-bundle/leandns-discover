#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/leandns-discoverd ] || return 0
	mkdir -p /etc/leandns
	if [ ! -s /etc/leandns/udp.token ]; then
		tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 24 > /etc/leandns/udp.token || \
			date +%s | md5sum | cut -c1-24 > /etc/leandns/udp.token
		chmod 600 /etc/leandns/udp.token
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/leandns-discoverd
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
