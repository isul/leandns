config leandns 'main'
	option enabled '1'
	option force_password_change '1'
	option ipv6_dns '0'
	option query_log '1'
	option query_log_max '20'
	option internal_domain 'home.arpa'
	option cachesize '1000'
	option dns_test_host 'one.one.one.one'
	option udp_token_required '0'
	option udp_set_enabled '0'
	option min_free_ram_kb '8192'
	option min_tmp_kb '2048'
	option upgrade_headroom_kb '6144'
	option ui_listen 'lan'
	list upstream '1.1.1.1'
	list upstream '8.8.8.8'

config network 'lan'
	option ipaddr '192.168.0.250'
	option netmask '255.255.255.0'
	option gateway '192.168.0.1'
	option dns_appliance '1'
	option dhcp_server '0'
