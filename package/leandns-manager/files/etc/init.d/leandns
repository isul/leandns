#!/bin/sh /etc/rc.common
# LeanDNS manager service — applies DNS appliance profile safely.

START=99
STOP=10
USE_PROCD=1

NAME=leandns
PROG=/usr/libexec/leandns/apply-dns.sh

start_service() {
	enabled="$(uci -q get leandns.main.enabled)"
	[ "$enabled" = "0" ] && return 0

	procd_open_instance
	procd_set_param command /bin/sh -c "$PROG --boot; exec sleep infinity"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	"$PROG" --apply || return 1
}

service_triggers() {
	procd_add_reload_trigger leandns dhcp
}
