#!/bin/sh /etc/rc.common
# LeanDNS RAM-only block stats collector.

START=99
STOP=10
USE_PROCD=1

NAME=leandns-stats
STATS=/usr/libexec/leandns/stats-ctl.sh

start_service() {
	[ -x "$STATS" ] || return 0
	enabled="$(uci -q get leandns.main.enabled 2>/dev/null || echo 1)"
	[ "$enabled" = "0" ] && return 0
	query_log="$(uci -q get leandns.main.query_log 2>/dev/null || echo 0)"
	[ "$query_log" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /bin/sh -c \
		'while true; do /usr/libexec/leandns/stats-ctl.sh tick; /usr/libexec/leandns/stats-ctl.sh trim; sleep 2; done'
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	"$STATS" trim >/dev/null 2>&1 || true
	# Restart so enable/disable of query_log takes effect.
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger leandns
}
