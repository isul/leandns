#!/bin/sh
# First-boot defaults for LeanDNS DNS appliance.
# Does NOT rewrite the main router DHCP/DNS settings.

. /lib/functions.sh

LEANDNS_MARK=/etc/leandns/.initialized

[ -f "$LEANDNS_MARK" ] && exit 0

# Disable DHCP server on lan (main router handles DHCP)
uci -q batch <<-EOF
	set dhcp.lan.ignore='1'
	delete dhcp.lan.dhcpv4
	delete dhcp.lan.dhcpv6
	delete dhcp.lan.ra
	set dhcp.@dnsmasq[0].domainneeded='1'
	set dhcp.@dnsmasq[0].localise_queries='1'
	set dhcp.@dnsmasq[0].rebind_protection='1'
	set dhcp.@dnsmasq[0].localservice='1'
	set dhcp.@dnsmasq[0].cachesize='1000'
	set dhcp.@dnsmasq[0].domain='home.arpa'
	set dhcp.@dnsmasq[0].local='/home.arpa/'
	set dhcp.@dnsmasq[0].confdir='/tmp/dnsmasq.d'
	delete dhcp.@dnsmasq[0].server
	add_list dhcp.@dnsmasq[0].server='1.1.1.1'
	add_list dhcp.@dnsmasq[0].server='8.8.8.8'
EOF

# Optional LAN static profile — only if leandns.network.dns_appliance=1
if [ "$(uci -q get leandns.lan.dns_appliance)" = "1" ]; then
	ipaddr="$(uci -q get leandns.lan.ipaddr)"
	netmask="$(uci -q get leandns.lan.netmask)"
	gateway="$(uci -q get leandns.lan.gateway)"
	ipaddr="${ipaddr:-192.168.0.250}"
	netmask="${netmask:-255.255.255.0}"
	gateway="${gateway:-192.168.0.1}"

	uci -q batch <<-EOF
		set network.lan.proto='static'
		set network.lan.ipaddr='$ipaddr'
		set network.lan.netmask='$netmask'
		set network.lan.gateway='$gateway'
		delete network.wan
		delete network.wan6
	EOF
fi

# Disable wireless radios if present (DNS appliance — save RAM/flash)
if [ -f /etc/config/wireless ]; then
	uci -q set wireless.radio0.disabled='1'
	uci -q set wireless.radio1.disabled='1'
	uci -q set wireless.default_radio0.disabled='1'
	uci -q set wireless.default_radio1.disabled='1'
fi

# uhttpd: serve LeanDNS at / (symlinks via www-root.sh); keep listen on LAN.
# Drop broken LuCI lua handler (full UI theme not installed).
uci -q batch <<-EOF
	set uhttpd.main.rfc1918_filter='1'
	set uhttpd.main.redirect_https='0'
	delete uhttpd.main.lua_prefix
	delete uhttpd.main.index_page
	add_list uhttpd.main.index_page='index.html'
EOF

[ -x /usr/libexec/leandns/www-root.sh ] && /usr/libexec/leandns/www-root.sh || true




# Force password change flag for UI
uci -q set leandns.main.force_password_change='1'
uci -q set leandns.main.enabled='1'

uci -q commit dhcp
uci -q commit network
uci -q commit wireless 2>/dev/null
uci -q commit uhttpd
uci -q commit leandns

mkdir -p /etc/leandns /var/lib/leandns
touch "$LEANDNS_MARK"

# Apply dnsmasq hostfile hook if helpers exist
[ -x /usr/libexec/leandns/apply-dns.sh ] && /usr/libexec/leandns/apply-dns.sh --boot || true

exit 0
