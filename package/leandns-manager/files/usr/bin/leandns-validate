#!/bin/sh
# LeanDNS input validators — exit 0 on success, 1 on failure.
# Usage: leandns-validate <type> <value...>

set -eu

usage() {
	echo "usage: leandns-validate domain|ipv4|ipv6|hostrecord|port|cachesize|upstream <value...>" >&2
	exit 2
}

[ "$#" -ge 2 ] || usage
TYPE="$1"
shift

is_domain() {
	# RFC-ish hostname labels, optional trailing dot; no spaces
	echo "$1" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\.?$' || return 1
	[ "${#1}" -le 253 ] || return 1
	# reject consecutive dots and empty labels already handled; reject leading hyphen per label via regex
	echo "$1" | grep -Eq '\.\.' && return 1
	return 0
}

is_ipv4() {
	echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	oldIFS="$IFS"
	IFS=.
	# shellcheck disable=SC2086
	set -- $1
	IFS="$oldIFS"
	for o in "$1" "$2" "$3" "$4"; do
		[ "$o" -ge 0 ] 2>/dev/null && [ "$o" -le 255 ] 2>/dev/null || return 1
	done
	return 0
}

is_ipv6() {
	# pragmatic check — full RFC validation is heavy for ash
	echo "$1" | grep -Eq '^[0-9A-Fa-f:]+$' || return 1
	echo "$1" | grep -q ':' || return 1
	[ "${#1}" -le 45 ] || return 1
	return 0
}

is_port() {
	echo "$1" | grep -Eq '^[0-9]+$' || return 1
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

is_cachesize() {
	echo "$1" | grep -Eq '^[0-9]+$' || return 1
	[ "$1" -ge 0 ] && [ "$1" -le 10000 ]
}

case "$TYPE" in
	domain)
		is_domain "$1"
		;;
	ipv4)
		is_ipv4 "$1"
		;;
	ipv6)
		is_ipv6 "$1"
		;;
	hostrecord)
		[ "$#" -ge 2 ] || usage
		is_domain "$1" || exit 1
		if is_ipv4 "$2"; then
			exit 0
		fi
		is_ipv6 "$2"
		;;
	port)
		is_port "$1"
		;;
	cachesize)
		is_cachesize "$1"
		;;
	upstream)
		# IPv4, IPv6, or host; optional #port
		raw="$1"
		host="${raw%%#*}"
		port=""
		case "$raw" in
			*#*) port="${raw#*#}" ;;
		esac
		if [ -n "$port" ]; then
			is_port "$port" || exit 1
		fi
		is_ipv4 "$host" && exit 0
		is_ipv6 "$host" && exit 0
		is_domain "$host"
		;;
	*)
		usage
		;;
esac
