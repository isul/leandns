#!/bin/sh
# rpcd plugin for LeanDNS (BusyBox ash). Speaks JSON on stdout.
# Methods mirror ACL in /usr/share/rpcd/acl.d/leandns.json

. /usr/share/libubox/jshn.sh 2>/dev/null || true

HOSTS=/etc/leandns/hosts
ALLOW=/etc/leandns/allow.list
BLOCK=/etc/leandns/block.list
VALIDATE=/usr/bin/leandns-validate
NETWORK=/usr/libexec/leandns/apply-network.sh
TOKEN=/etc/leandns/udp.token

new_udp_token() {
	umask 077
	tmp="$(mktemp /etc/leandns/.udp.token.XXXXXX)" || return 1
	value="$(hexdump -n 16 -e '16/1 "%02x"' /dev/urandom)"
	if [ "${#value}" -eq 32 ] && printf '%s\n' "$value" > "$tmp" && mv -f "$tmp" "$TOKEN"; then
		return 0
	fi
	rm -f "$tmp"
	return 1
}

udp_enabled() {
	[ "$(uci -q get leandns.main.udp_set_enabled || echo 0)" = 1 ]
}

udp_token_required() {
	[ "$(uci -q get leandns.main.udp_token_required || echo 0)" = 1 ]
}

udp_required_json() {
	udp_token_required && echo true || echo false
}

udp_enabled_json() {
	udp_enabled && echo true || echo false
}

case "$1" in
	list)
		cat <<'EOF'
{
	"ping": {},
	"auth_required": {},
	"status": {},
	"dns_get": {},
	"dns_set": {
		"upstream": [],
		"cachesize": 1000,
		"internal_domain": "home.arpa",
		"ipv6_dns": false,
		"dns_test_host": "one.one.one.one"
	},
	"dns_test": { "host": "" },
	"dns_restart": {},
	"hosts_list": {},
	"hosts_set": { "hosts": [] },
	"adblock_status": {},
	"adblock_set": { "enabled": true },
	"adblock_update": {},
	"lists_get": {},
	"lists_set": { "allow": [], "block": [] },
	"system_info": {},
	"system_restart_services": {},
	"firmware_status": {},
	"firmware_prepare": { "size": 0 },
	"firmware_verify": {},
	"firmware_abort": {},
	"firmware_apply": { "keep_settings": true },
	"logs_get": { "lines": 100 },
	"logs_clear": {},
	"backup_export": {},
	"backup_import": { "data_base64": "" },
	"password_changed": {},
	"network_get": {},
	"network_set": {
		"ipaddr": "192.168.0.250",
		"netmask": "255.255.255.0",
		"gateway": "192.168.0.1"
	},
	"network_confirm": {},
	"udp_token_get": { "reveal": true },
	"udp_token_set": { "enabled": true, "required": true },
	"udp_token_regen": {}
}
EOF
		;;
	call)
		method="$2"
		# Full stdin (do not use read -r; JSON may be multi-line)
		input="$(cat)"
		[ -n "$input" ] || input="{}"
		case "$method" in
			ping)
				ver="$(tr -d '\r\n' < /etc/leandns/version 2>/dev/null || true)"
				ver="${ver:-1.0.1}"
				fw=
				if [ -r /etc/openwrt_release ]; then
					# shellcheck disable=SC1091
					. /etc/openwrt_release
					fw="${DISTRIB_DESCRIPTION:-${DISTRIB_RELEASE:-}}"
				fi
				[ -n "$fw" ] || fw=unsupported
				ver_j="$(printf '%s' "$ver" | sed 's/\\/\\\\/g; s/"/\\"/g')"
				fw_j="$(printf '%s' "$fw" | sed 's/\\/\\\\/g; s/"/\\"/g')"
				printf '{"ok":true,"service":"leandns","version":"%s","firmware":"%s"}\n' "$ver_j" "$fw_j"
				;;
			auth_required)
				# Real check: /etc/shadow (UCI force_password_change is only a cache).
				# root:: / root:! / root:* / root:x = unset/locked; root:$… = password set.
				# SSH passwd does not clear the UCI flag, so never trust UCI alone.
				if grep -q '^root:[^!*:x]' /etc/shadow 2>/dev/null; then
					# Heal stale flag left over from install / older builds
					if [ "$(uci -q get leandns.main.force_password_change 2>/dev/null)" = "1" ]; then
						uci -q set leandns.main.force_password_change='0'
						uci commit leandns
					fi
					echo '{"force_password_change":false}'
				else
					echo '{"force_password_change":true}'
				fi
				;;
			status)
				/usr/libexec/leandns/status.sh --quick
				;;
			dns_get)
				domain="$(uci -q get leandns.main.internal_domain)"
				cache="$(uci -q get leandns.main.cachesize)"
				ipv6="$(uci -q get leandns.main.ipv6_dns)"
				test_host="$(uci -q get leandns.main.dns_test_host)"
				ups="$(/usr/libexec/leandns/upstream-list.sh get-json)"
				printf '{"upstream":[%s],"cachesize":%s,"internal_domain":"%s","ipv6_dns":%s,"dns_test_host":"%s"}\n' \
					"$ups" "${cache:-1000}" "${domain:-home.arpa}" \
					"$([ "${ipv6:-0}" = "1" ] && echo true || echo false)" \
					"${test_host:-one.one.one.one}"
				;;
			dns_set)
				# Prefer jshn when available
				cache=""; domain=""; test_host=""; ipv6_raw=""; have_upstream=0
				if [ -f /usr/share/libubox/jshn.sh ]; then
					# shellcheck disable=SC1091
					. /usr/share/libubox/jshn.sh
					json_init
					json_load "$input" 2>/dev/null || true
					json_get_var cache cachesize
					json_get_var domain internal_domain
					json_get_var test_host dns_test_host
					json_get_var ipv6_raw ipv6_dns
					json_get_type utype upstream
					if [ "$utype" = "array" ]; then
						have_upstream=1
						uptmp="$(mktemp)"
						json_select upstream
						json_get_keys ukeys
						for uk in $ukeys; do
							json_get_var srv "$uk"
							[ -n "$srv" ] && printf '%s\n' "$srv" >> "$uptmp"
						done
						json_select ..
					fi
				fi
				# Fallback sed parse
				[ -n "$cache" ] || cache="$(printf '%s' "$input" | sed -n 's/.*"cachesize"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"
				[ -n "$domain" ] || domain="$(printf '%s' "$input" | sed -n 's/.*"internal_domain"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				[ -n "$test_host" ] || test_host="$(printf '%s' "$input" | sed -n 's/.*"dns_test_host"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				[ -n "$ipv6_raw" ] || ipv6_raw="$(printf '%s' "$input" | sed -n 's/.*"ipv6_dns"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' | head -n1)"
				if [ "$have_upstream" != "1" ] && printf '%s' "$input" | grep -q '"upstream"[[:space:]]*:'; then
					have_upstream=1
					arr="$(printf '%s' "$input" | sed -n 's/.*"upstream"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' | head -n1)"
					uptmp="$(mktemp)"
					printf '%s\n' "$arr" | sed 's/"[[:space:]]*,[[:space:]]*"/\n/g; s/"//g' > "$uptmp"
				fi

				[ -n "$cache" ] && {
					"$VALIDATE" cachesize "$cache" || { echo '{"ok":false,"error":"invalid cachesize"}'; exit 0; }
					uci -q set leandns.main.cachesize="$cache"
				}
				[ -n "$domain" ] && {
					"$VALIDATE" domain "$domain" || { echo '{"ok":false,"error":"invalid domain"}'; exit 0; }
					uci -q set leandns.main.internal_domain="$domain"
				}
				[ -n "$test_host" ] && {
					"$VALIDATE" domain "$test_host" || { echo '{"ok":false,"error":"invalid dns_test_host"}'; exit 0; }
					uci -q set leandns.main.dns_test_host="$test_host"
				}
				case "$ipv6_raw" in
					true|1) uci -q set leandns.main.ipv6_dns='1' ;;
					false|0) uci -q set leandns.main.ipv6_dns='0' ;;
				esac

				if [ "$have_upstream" = "1" ] && [ -n "${uptmp:-}" ]; then
					/usr/libexec/leandns/upstream-list.sh set-lines < "$uptmp" >/dev/null
					rm -f "$uptmp"
				else
					uci commit leandns
				fi

				if /usr/libexec/leandns/apply-dns.sh --apply >/dev/null 2>&1; then
					echo '{"ok":true}'
				else
					echo '{"ok":false,"error":"apply failed; rolled back"}'
				fi
				;;
			dns_test)
				json_load "$input"
				json_get_var host host
				/usr/libexec/leandns/status.sh --dns-test "$host"
				;;
			dns_restart)
				if /etc/init.d/dnsmasq restart >/dev/null 2>&1; then
					echo '{"ok":true}'
				else
					echo '{"ok":false,"error":"restart failed"}'
				fi
				;;
			hosts_list)
				printf '{"hosts":['
				first=1
				[ -f "$HOSTS" ] && while IFS= read -r line || [ -n "$line" ]; do
					case "$line" in ''|\#*) continue ;; esac
					# shellcheck disable=SC2086
					set -- $line
					h="$1"; ip="$2"
					[ -n "$h" ] && [ -n "$ip" ] || continue
					[ "$first" = 1 ] || printf ','
					first=0
					printf '{"hostname":"%s","ip":"%s"}' "$h" "$ip"
				done < "$HOSTS"
				printf ']}\n'
				;;
			hosts_set)
				json_load "$input"
				json_get_type type hosts
				if [ "$type" != array ] || ! json_select hosts; then
					echo '{"ok":false,"error":"내부 DNS 레코드 목록이 필요합니다."}'
					exit 0
				fi
				tmp="$(mktemp /etc/leandns/.hosts.XXXXXX)" || {
					echo '{"ok":false,"error":"임시 레코드 파일 생성 실패"}'
					exit 0
				}
				trap 'rm -f "$tmp"' EXIT
				json_get_keys keys
				for key in $keys; do
					h=
					ip=
					if json_select "$key"; then
						json_get_var h hostname
						json_get_var ip ip
						json_select ..
					fi
					case "$h" in *[!A-Za-z0-9.-]*) h= ;; esac
					case "$ip" in *[!0-9a-fA-F.:]*) ip= ;; esac
					if ! "$VALIDATE" hostrecord "$h" "$ip"; then
						echo '{"ok":false,"error":"호스트 이름과 IP 주소를 확인하세요."}'
						exit 0
					fi
					printf '%s %s\n' "$h" "$ip" >> "$tmp"
				done
				if /usr/libexec/leandns/apply-dns.sh --hosts "$tmp" >/dev/null 2>&1; then
					echo '{"ok":true}'
				else
					echo '{"ok":false,"error":"내부 DNS 레코드를 적용하지 못했습니다."}'
				fi
				;;
			adblock_status)
				/usr/libexec/leandns/adblock-ctl.sh status
				;;
			adblock_set)
				en="$(printf '%s' "$input" | sed -n 's/.*"enabled"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' | head -n1)"
				if [ "$en" = "true" ]; then
					/usr/libexec/leandns/adblock-ctl.sh enable
				else
					/usr/libexec/leandns/adblock-ctl.sh disable
				fi
				;;
			adblock_update)
				/usr/libexec/leandns/adblock-ctl.sh update
				;;
			lists_get)
				printf '{"allow":['
				fa=1
				[ -f "$ALLOW" ] && while IFS= read -r d || [ -n "$d" ]; do
					case "$d" in ''|\#*) continue ;; esac
					[ "$fa" = 1 ] || printf ','
					fa=0
					printf '"%s"' "$d"
				done < "$ALLOW"
				printf '],"block":['
				fb=1
				[ -f "$BLOCK" ] && while IFS= read -r d || [ -n "$d" ]; do
					case "$d" in ''|\#*) continue ;; esac
					[ "$fb" = 1 ] || printf ','
					fb=0
					printf '"%s"' "$d"
				done < "$BLOCK"
				printf ']}\n'
				;;
			lists_set)
				tmpa="$(mktemp)"; tmpb="$(mktemp)"
				# Split allow / block sections crudely
				allow_part="$(printf '%s' "$input" | sed -n 's/.*"allow"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')"
				block_part="$(printf '%s' "$input" | sed -n 's/.*"block"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')"
				# BusyBox tr lacks [:space:] classes and would delete letters a,c,e,s,p instead.
				printf '%s\n' "$allow_part" | sed 's/"[[:space:]]*,[[:space:]]*"/\n/g; s/"//g' | while IFS= read -r d; do
					d="$(printf '%s' "$d" | tr -d ' \t\r\n')"
					[ -z "$d" ] && continue
					"$VALIDATE" domain "$d" || continue
					printf '%s\n' "$d"
				done | sort -u > "$tmpa"
				printf '%s\n' "$block_part" | sed 's/"[[:space:]]*,[[:space:]]*"/\n/g; s/"//g' | while IFS= read -r d; do
					d="$(printf '%s' "$d" | tr -d ' \t\r\n')"
					[ -z "$d" ] && continue
					"$VALIDATE" domain "$d" || continue
					printf '%s\n' "$d"
				done | sort -u > "$tmpb"
				cp "$tmpa" "$ALLOW"
				cp "$tmpb" "$BLOCK"
				rm -f "$tmpa" "$tmpb"
				/usr/libexec/leandns/adblock-ctl.sh sync-lists >/dev/null 2>&1 || true
				echo '{"ok":true}'
				;;
			system_info)
				/usr/libexec/leandns/status.sh --system
				;;
			system_restart_services)
				/etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
				/etc/init.d/leandns reload >/dev/null 2>&1 || true
				echo '{"ok":true}'
				;;
			firmware_status)
				/usr/libexec/leandns/firmware-ctl.sh status
				;;
			firmware_prepare)
				sz="$(printf '%s' "$input" | sed -n 's/.*"size"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"
				sz="${sz:-0}"
				/usr/libexec/leandns/firmware-ctl.sh prepare "$sz"
				;;
			firmware_verify)
				/usr/libexec/leandns/firmware-ctl.sh verify
				;;
			firmware_abort)
				/usr/libexec/leandns/firmware-ctl.sh abort
				;;
			firmware_apply)
				keep="$(printf '%s' "$input" | sed -n 's/.*"keep_settings"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' | head -n1)"
				keep="${keep:-true}"
				/usr/libexec/leandns/firmware-ctl.sh apply "$keep"
				;;
			logs_get)
				lines="$(printf '%s' "$input" | sed -n 's/.*"lines"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -n1)"
				lines="${lines:-100}"
				[ "$lines" -gt 500 ] && lines=500
				logread 2>/dev/null | grep -E 'dnsmasq|leandns|adblock' | tail -n "$lines" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'BEGIN{print "{\"lines\":["} {if(n++)printf ","; printf "\"%s\"",$0} END{print "]}"}'
				;;
			logs_clear)
				# Clearing persistent logs on flash is discouraged; truncate logd buffer if possible
				logread -c >/dev/null 2>&1 || true
				echo '{"ok":true,"note":"log buffer clear attempted"}'
				;;
			backup_export)
				/usr/libexec/leandns/backup.sh export
				;;
			backup_import)
				b64="$(printf '%s' "$input" | sed -n 's/.*"data_base64"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
				if [ -z "$b64" ]; then
					echo '{"ok":false,"error":"missing data_base64"}'
				else
					printf '%s' "$b64" | /usr/libexec/leandns/backup.sh import
				fi
				;;
			password_changed)
				# Optional explicit clear; auth_required also heals from /etc/shadow.
				uci -q set leandns.main.force_password_change='0'
				uci commit leandns
				echo '{"ok":true}'
				;;
			network_get)
				ipaddr="$(uci -q get network.lan.ipaddr)"
				netmask="$(uci -q get network.lan.netmask)"
				gateway="$(uci -q get network.lan.gateway)"
				pending="$("$NETWORK" --pending)"
				printf '{"ipaddr":"%s","netmask":"%s","gateway":"%s",%s}\n' \
					"${ipaddr:-192.168.0.250}" "${netmask:-255.255.255.0}" "${gateway:-192.168.0.1}" "$pending"
				;;
			network_set)
				ipaddr="$(printf '%s' "$input" | sed -n 's/.*"ipaddr"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				netmask="$(printf '%s' "$input" | sed -n 's/.*"netmask"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				gateway="$(printf '%s' "$input" | sed -n 's/.*"gateway"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
				[ -n "$ipaddr" ] && [ -n "$netmask" ] && [ -n "$gateway" ] || {
					echo '{"ok":false,"error":"missing fields"}'
					exit 0
				}
				"$NETWORK" --web "$ipaddr" "$netmask" "$gateway"
				;;
			network_confirm)
				"$NETWORK" --confirm
				;;
			udp_token_get)
				json_load "$input"
				json_get_var reveal reveal
				# Ensure UDP SET stays available; checkbox only controls token requirement.
				if ! udp_enabled; then
					uci -q set leandns.main.udp_set_enabled=1
					uci commit leandns >/dev/null 2>&1 || true
				fi
				if [ "$reveal" = 1 ]; then
					if [ ! -s "$TOKEN" ] && ! new_udp_token; then
						echo '{"ok":false,"error":"토큰 생성 실패"}'
						exit 0
					fi
					tok="$(tr -cd 'A-Za-z0-9' < "$TOKEN")"
					printf '{"token":"%s","port":37421,"required":%s,"enabled":%s}\n' \
						"$tok" "$(udp_required_json)" "$(udp_enabled_json)"
				else
					printf '{"port":37421,"required":%s,"enabled":%s}\n' \
						"$(udp_required_json)" "$(udp_enabled_json)"
				fi
				;;
			udp_token_set)
				json_load "$input"
				json_get_var enabled enabled
				json_get_var required required
				# Prefer explicit required. Legacy clients sent only enabled:
				# enabled=1 → token on, enabled=0 → token off (SET still allowed).
				case "$required" in
					0|false) req=0 ;;
					1|true) req=1 ;;
					*)
						case "$enabled" in
							0|false) req=0 ;;
							1|true) req=1 ;;
							*)
								echo '{"ok":false,"error":"required 또는 enabled 값이 필요합니다."}'
								exit 0
								;;
						esac
						;;
				esac
				if uci -q set leandns.main.udp_token_required="$req" &&
					uci -q set leandns.main.udp_set_enabled=1 &&
					uci commit leandns; then
					printf '{"ok":true,"required":%s,"enabled":true}\n' "$(udp_required_json)"
				else
					echo '{"ok":false,"error":"UDP 설정 저장 실패"}'
				fi
				;;
			udp_token_regen)
				if new_udp_token; then
					echo '{"ok":true,"port":37421}'
				else
					echo '{"ok":false,"error":"토큰 재발급 실패"}'
				fi
				;;
			*)
				echo '{"error":"unknown method"}'
				;;
		esac
		;;
esac
